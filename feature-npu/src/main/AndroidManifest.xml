<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 17 (API 37) introduced PackageManager.FEATURE_NEURAL_PROCESSING_UNIT, backed by the
      device feature string "android.hardware.npu". required="false" is deliberate: most devices
      in the field, including everything below API 37, do not have this feature. See NpuFeature.kt
      and DelegateSelector.kt for the runtime fallback this enables.
    -->
    <uses-feature
        android:name="android.hardware.npu"
        android:required="false" />

</manifest>
