<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The real UI is all Compose (PlatformResetTheme, core-design), driven by the design
         mockups' exact colors. This XML theme only needs to cover the moment before Compose
         takes over: the window background, so it matches the mockup's dark background instead
         of flashing white. -->
    <style name="Theme.PlatformReset" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
        <item name="android:navigationBarColor">@color/launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
